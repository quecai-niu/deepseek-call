PORT=5173

# Public Supabase project settings. Use the publishable key or legacy anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend-only Supabase key. Use the secret key or legacy service_role key.
# Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend-only model/search keys.
DEEPSEEK_API_KEY=sk-your-deepseek-key
TAVILY_API_KEY=tvly-your-tavily-key

# Context sent to the model. Full history is still stored in Postgres.
CONTEXT_MESSAGE_LIMIT=80
CONTEXT_CHAR_BUDGET=32000
